BootStrap: docker
From: rocker/geospatial:latest

%post
    apt-get update && apt-get install -y \
        ca-certificates \
        libarchive13 \
        libcurl4-openssl-dev \
        locales \
        && rm -rf /var/lib/apt/lists/*

    locale-gen en_US.UTF-8

    echo "LANG=en_US.UTF-8" >> /etc/default/locale
    echo "LC_ALL=en_US.UTF-8" >> /etc/default/locale

    Rscript -e "install.packages(c('pak', 'qs2', 'mirai', 'mori', 'h3jsr'))"
    Rscript -e "pak::pak('NIEHS/amadeus')"
    Rscript -e 'pak::pkg_install("NIEHS/beethoven@mm-1013", dependencies = TRUE)'
    Rscript -e 'options(timeout = 1800); pak::pkg_install("sparklyr", dependencies = TRUE); sparklyr::spark_install()'
    Rscript -e 'options(timeout = 1800); install.packages("arrow")'

%environment
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
    export TERM=xterm-256color
    
    # Enforce sterile R environment.
    export R_ENVIRON_USER=/dev/null
    export R_PROFILE_USER=/dev/null
    export R_LIBS_USER=""
    export R_LIBS_SITE="/usr/local/lib/R/site-library:/usr/local/lib/R/library"

%runscript
    echo "{beethoven} container"
