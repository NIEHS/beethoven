.Rhistory
.Rapp.history
.Ruserdata
.RData
.RDataTmp
.Renviron

# Hidden and temporary folders
._.*
._.gitignore
._*
.DS_Store/
._.DS_Store/
/.DS_Store
/._.DS_Store
*.zip
