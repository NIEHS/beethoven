# Ignore specific folders
doc/
input/
output/
slurm/
_targets/
.snakemake/

# Development files and folers.
inst/devel/
inst/container/def/container_dev.def
inst/container/sh/build_container_dev.sh

# Vignettes
vignettes/*.html
vignettes/*.pdf

# Large container files
*.sif

# Slurm-related error files
*.err
*.out

# R user/session files.
.Rhistory
.Rapp.history
.Ruserdata
.RData
.RDataTmp
.Renviron

# Hidden and temporary folders
._.*
._.gitignore
._*
.DS_Store/
._.DS_Store/
/.DS_Store
/._.DS_Store
*.zip
